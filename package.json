{
  "name": "@pushizo/node",
  "version": "0.1.0",
  "description": "Pushizo Node.js sunucu SDK'sı: public API'nin tamamı (bildirim, kullanıcı, segment, şablon, kampanya, analitik, veri aktarımı, webhook…) OpenAPI tipleri ile",
  "license": "MIT",
  "homepage": "https://github.com/exec0de/pushizo/tree/main/sdk/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exec0de/pushizo.git",
    "directory": "sdk/node"
  },
  "bugs": {
    "url": "https://github.com/exec0de/pushizo/issues"
  },
  "keywords": [
    "pushizo",
    "push",
    "notifications",
    "email",
    "sms",
    "webhooks",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@pushizo/api-client": "*"
  },
  "engines": {
    "node": ">=20"
  }
}
